{
  "name": "@sakulime-ui/core",
  "version": "0.4.5",
  "description": "CSS-first UI components via sl-* HTML attributes — buttons, cards, notices, icons, and themes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syntony666/sakulime-ui.git",
    "directory": "packages/core"
  },
  "homepage": "https://sakulime-ui.syntony666.com",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.min.js"
    },
    "./index.css": "./dist/index.min.css",
    "./icons": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.min.js"
    },
    "./index.min.css": "./dist/index.min.css",
    "./index.min.js": "./dist/index.min.js"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.dts.json"
  },
  "devDependencies": {
    "@sakulime-ui/shared": "*",
    "@sakulime-ui/theme": "*",
    "postcss-custom-selectors": "^9.0.4"
  }
}
