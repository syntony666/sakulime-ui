{
  "name": "sakulime-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/elements.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./elements.js": "./dist/elements.js",
    "./sakulime.css": "./dist/sakulime.css",
    "./tokens.css": "./dist/tokens.css",
    "./themes/*": "./dist/themes/*"
  },
  "scripts": {
