{
  "name": "sakulime-ui",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/shared/*",
    "doc"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/sakulime.min.js",
    "./sakulime.min.css": "./dist/sakulime.min.css",
    "./sakulime.min.js": "./dist/sakulime.min.js"
  },
  "scripts": {
    "dev": "npm run dev -w sakulime-doc",
    "build": "tsc -b && npm run build -w @sakulime-ui/core && node scripts/build.mjs",
    "lint": "eslint .",
    "preview": "npm run preview -w sakulime-doc",
    "storybook": "npm run storybook -w sakulime-doc",
    "build-storybook": "npm run build-storybook -w sakulime-doc",
    "site": "npm run site -w sakulime-doc",
    "deploy": "npm run deploy -w sakulime-doc",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "eslint": "^10.3.0",
    "eslint-plugin-mdx": "^3.8.2",
    "eslint-plugin-storybook": "^10.4.6",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
